/* ==========================================================================
   VIEW DE PERFIL
   ========================================================================== */

#perfil {
    padding: 16px 16px 32px 16px;
    max-width: 600px;
    margin: 0 auto;
    position: relative;
}

/* Background Blur de Perfil */
.perfil-bg-blur {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 220px;
    overflow: hidden;
    z-index: 0;
    mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 30%, rgba(0,0,0,0) 100%);
    -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 30%, rgba(0,0,0,0) 100%);
}

.perfil-bg-blur img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(24px) opacity(0.35);
    transform: scale(1.1);
}

/* Header de Perfil */
/* Header de Perfil */
.perfil-header {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: row; /* Alinha foto e textos lado a lado */
    align-items: center;
    justify-content: flex-start; /* Alinha todo o conteúdo à esquerda */
    padding: 24px 16px 20px 16px;
    gap: 16px; /* Espaço entre a foto e o texto */
}

.perfil-avatar-large {
    position: relative;
    width: 80px; /* Reduzido um pouco para casar com o tamanho do print */
    height: 80px;
    margin-bottom: 0; /* Remove a margem inferior antiga */
    flex-shrink: 0;
}

.perfil-avatar-large img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.2); /* Borda fina clara como no print */
    background-color: var(--bg-card);
}

/* Novo container para agrupar o Nome e a Localização (Ex: Brazil) */
.perfil-dados-texto {
    display: flex;
    flex-direction: column;
    align-items: flex-start; /* Alinha os textos à esquerda */
    justify-content: center;
}

.perfil-nome {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
    text-align: left; /* Alinhado à esquerda */
    letter-spacing: -0.3px;
}

/* Nova classe para a localização abaixo do nome */
.perfil-localizacao {
    font-size: 0.9rem;
    color: var(--text-secondary); /* Cor cinza/secundária */
    margin-top: 2px;
}

/* Engrenagem de Configuração no canto superior direito */
.btn-config-header {
    position: absolute;
    top: 24px;
    right: 16px;
    background: none;
    border: none;
    color: var(--text-main);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
}

.btn-config-header .material-symbols-outlined {
    font-size: 24px;
}

.btn-trocar-foto {
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--accent-gradient);
    color: var(--text-main);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
    transition: transform 0.2s ease;
}

.btn-trocar-foto:hover {
    transform: scale(1.1);
}

.btn-trocar-foto .material-symbols-outlined {
    font-size: 18px;
}


/* Lista de Opções e Links */
.perfil-opcoes {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 12px;
    position: relative;
    z-index: 1;
}

.opcao-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    background-color: var(--bg-card);
    border: 1px solid var(--border-glass);
    border-radius: 12px;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
}

.opcao-item:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.15);
}

.opcao-item:active {
    transform: scale(0.99);
}

.opcao-info {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-main);
}

.opcao-info .material-symbols-outlined {
    color: var(--accent-color);
    font-size: 22px;
}

.chevron {
    color: var(--text-secondary);
    font-size: 20px;
}
